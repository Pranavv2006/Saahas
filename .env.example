# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MongoDB Atlas connection string.
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/saahas?retryWrites=true&w=majority"

# Public URL where the application is hosted.
APP_URL="MY_APP_URL"

# Twilio credentials must only be configured on the server.
# Copy these entries to .env.local and replace the placeholder values.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"

# Twilio WhatsApp Sandbox sender. Sandbox recipients must first join your sandbox.
TWILIO_WHATSAPP_FROM="+14155238886"

# Optional: required only if you also want SMS delivery.
TWILIO_SMS_FROM="+15017122661"

# Used when the UI supplies a local 10-digit number (91 = India).
TWILIO_DEFAULT_COUNTRY_CODE="91"
